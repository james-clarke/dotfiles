[core]
	pager = delta

[init]
	defaultBranch = main

[pull]
	rebase = false

[push]
	autoSetupRemote = true

[fetch]
	prune = true

[rerere]
	enabled = true

[merge]
	conflictstyle = zdiff3

[diff]
	colorMoved = default
	algorithm = histogram

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true
	side-by-side = false

[alias]
	co = checkout
	br = branch
	st = status -sb
	cm = commit -m
	last = log -1 HEAD
	unstage = reset HEAD --
	hist = log --oneline --graph --decorate -30

[branch]
	sort = -committerdate

[commit]
	verbose = true

[rebase]
	autostash = true

[include]
	path = config.local
