#!/usr/bin/env bash
set -euo pipefail

REPO=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles"
OS=$(uname -s)
step() { printf '\n\033[1;34m== %s\033[0m\n' "$*"; }

LINKS=(
  "bin/dots:$HOME/.local/bin/dots"
  "claude/CLAUDE.md:$HOME/.claude/CLAUDE.md"
  "claude/settings.json:$HOME/.claude/settings.json"
  "claude/statusline.sh:$HOME/.claude/statusline.sh"
  "claude/skills:$HOME/.claude/skills"
  "config/git/config:$HOME/.config/git/config"
  "config/git/ignore:$HOME/.config/git/ignore"
  "emacs/early-init.el:$HOME/.config/emacs/early-init.el"
  "emacs/init.el:$HOME/.config/emacs/init.el"
  "emacs/templates:$HOME/.config/emacs/templates"
  "ghostty/config:$HOME/.config/ghostty/config"
  "zsh:$HOME/.config/zsh"
  "zsh/home.zshenv:$HOME/.zshenv"
)
if [ "$OS" = Linux ]; then
  LINKS+=(
    "kde/env.sh:$HOME/.config/plasma-workspace/env/dotfiles.sh"
    "kde/dotfiles-emacs.desktop:$HOME/.local/share/applications/dotfiles-emacs.desktop"
  )
fi

link() {
  local src=$1 dst=$2
  mkdir -p "$(dirname "$dst")"
  if [ -L "$dst" ]; then
    rm "$dst"
  elif [ -e "$dst" ]; then
    mv "$dst" "$dst.bak"
    echo "moved      $dst -> $dst.bak"
  fi
  ln -s "$src" "$dst"
  echo "linked     $dst"
}

check() {
  local src=$1 dst=$2
  if [ "$(readlink "$dst" 2>/dev/null)" = "$src" ]; then echo "ok         $dst"
  else echo "DRIFT      $dst"; rc=1; fi
}

links() {
  local mode=$1 pair src dst manifest old
  rc=0
  for pair in "${LINKS[@]}"; do
    src="$REPO/${pair%%:*}" dst="${pair#*:}"
    "$mode" "$src" "$dst"
  done
  if [ "$mode" = check ]; then return "$rc"; fi
  manifest="$STATE/links"
  if [ -f "$manifest" ]; then
    while read -r old; do
      case " ${LINKS[*]#*:} " in *" $old "*) continue ;; esac
      if [ -L "$old" ] && [[ $(readlink "$old") == "$REPO/"* ]]; then rm "$old"; echo "pruned     $old"; fi
    done < "$manifest"
  fi
  mkdir -p "$STATE"
  printf '%s\n' "${LINKS[@]#*:}" > "$manifest"
}

sync() {
  local last
  last=$(cat "$STATE/applied" 2>/dev/null || true)
  changed() { [ -z "$last" ] || ! git -C "$REPO" diff --quiet "$last" -- "$@" 2>/dev/null; }

  step "repo"
  git -C "$REPO" pull -q --ff-only || echo "pull failed (offline or diverged); continuing with the local tree"
  git -C "$REPO" submodule update --init -q

  step "links"
  links link
  export PATH="$HOME/.local/bin:$PATH"

  case $OS in
    Linux)  "$REPO/os/linux.sh" ;;
    Darwin) "$REPO/os/macos.sh" ;;
    *) echo "unsupported OS: $OS"; exit 1 ;;
  esac

  if changed emacs; then
    step "emacs daemon restart"
    case $OS in
      Linux)  systemctl --user restart emacs.service 2>/dev/null || echo "daemon not running; it starts with your session" ;;
      Darwin) launchctl kickstart -k "gui/$(id -u)/com.dotfiles.emacs" 2>/dev/null || echo "agent not loaded; it loads at next login" ;;
    esac
  fi
  case $OS in
    Linux)
      if changed kde; then
        if command -v kwriteconfig6 >/dev/null && [ -n "${KDE_SESSION_VERSION:-}" ]; then
          step "kde"; "$REPO/kde/apply.sh"
        else
          echo "kde/ changed but this is not a Plasma session; run kde/apply.sh after login"
        fi
      fi ;;
    Darwin)
      if changed os/macos/defaults.sh; then step "defaults"; "$REPO/os/macos/defaults.sh"; fi ;;
  esac
  mkdir -p "$STATE"
  git -C "$REPO" rev-parse HEAD > "$STATE/applied"

  step "done"
  cat <<TAIL
  0. open a new terminal (or: exec zsh) for shell changes
  1. log out / in  (login shell, session env, keyboard remap)
  2. claude        # log in, then:
     jq -r '.enabledPlugins | keys[]' $REPO/claude/settings.json | xargs -n1 claude plugin install
  3. dots check
TAIL
}

case ${1:-sync} in
  sync)  sync ;;
  link)  links link ;;
  check) links check ;;
  *) echo "usage: dots [sync|link|check]" >&2; exit 2 ;;
esac
