{
  "env": {
    "CAVEMAN_DEFAULT_MODE": "lite"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git log *)",
      "Bash(git diff*)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch -a)",
      "Bash(git branch -v)",
      "Bash(git branch --show-current)",
      "Bash(git branch --list *)",
      "Bash(git blame *)",
      "Bash(git grep *)",
      "Bash(git ls-files*)",
      "Bash(git rev-parse *)",
      "Bash(git remote -v)",
      "Bash(git stash list*)",
      "Bash(git worktree list*)",
      "Bash(git tag -l*)",
      "Bash(git cat-file *)",
      "Bash(rg *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(ls *)",
      "Bash(wc *)",
      "Bash(cut *)",
      "Bash(jq *)",
      "Bash(diff *)",
      "Bash(stat *)",
      "Bash(file *)",
      "Bash(which *)",
      "Bash(uv tool list*)",
      "Bash(npm ls*)",
      "Read(~/**)",
      "Read(//tmp/**)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:api.github.com)",
      "WebSearch",
      "Bash(sed -n *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(fd *)",
      "Bash(echo *)",
      "Bash(printf *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(tr *)",
      "Bash(command -v *)",
      "Bash(realpath *)",
      "Bash(readlink *)",
      "Bash(env)",
      "Bash(printenv *)",
      "Bash(dpkg-query *)",
      "Bash(dpkg -l *)",
      "Bash(dpkg --print-architecture)",
      "Bash(apt-cache *)",
      "Bash(apt list *)",
      "Bash(apt-mark showmanual)",
      "Bash(gpg --show-keys *)",
      "Bash(xdg-mime query *)",
      "Bash(kreadconfig6 *)",
      "Bash(systemctl --user status *)",
      "Bash(systemctl status *)",
      "Bash(shellcheck *)",
      "Bash(shfmt -d *)",
      "Bash(zsh -n *)",
      "Bash(ps *)",
      "Bash(pgrep *)",
      "Bash(du *)",
      "Bash(df *)"
    ],
    "deny": ["Edit", "MultiEdit", "Write", "NotebookEdit", "Bash(git push*)"],
    "defaultMode": "default",
    "additionalDirectories": ["/tmp"]
  },
  "model": "fable[1m]",
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "caveman@caveman": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    }
  },
  "language": "English",
  "spinnerTipsEnabled": false,
  "effortLevel": "high",
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "tui": "default",
  "prefersReducedMotion": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "verbose": false,
  "preferredNotifChannel": "notifications_disabled",
  "autoCompactEnabled": false,
  "terminalProgressBarEnabled": false
}
