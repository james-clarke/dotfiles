      "Bash(command -v *)",
      "Bash(cut *)",
      "Bash(date*)",
      "Bash(defaults read *)",
      "Bash(df *)",
      "Bash(diff *)",
      "Bash(dirname *)",
      "Bash(dpkg --print-architecture)",
      "Bash(dpkg -l *)",
      "Bash(dpkg-query *)",
      "Bash(du *)",
      "Bash(echo *)",
      "Bash(env)",
      "Bash(expr *)",
      "Bash(fc-list*)",
      "Bash(fd *)",
      "Bash(file *)",
      "Bash(find *)",
      "Bash(free *)",
      "Bash(getent *)",
      "Bash(gh issue list*)",
      "Bash(gh issue view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr list*)",
      "Bash(gh pr view *)",
      "Bash(gh repo view*)",
      "Bash(gh run list*)",
      "Bash(gh run view *)",
      "Bash(git blame *)",
      "Bash(git branch --list *)",
      "Bash(git branch --show-current)",
      "Bash(git branch -a)",
      "Bash(git branch -v)",
      "Bash(git branch)",
      "Bash(git cat-file *)",
      "Bash(git check-ignore *)",
      "Bash(git config --get *)",
      "Bash(git config --list*)",
      "Bash(git config -l*)",
      "Bash(git count-objects*)",
      "Bash(git describe *)",
      "Bash(git diff*)",
      "Bash(git fetch *)",
      "Bash(git for-each-ref*)",
      "Bash(git grep *)",
      "Bash(git log *)",
      "Bash(git ls-files*)",
      "Bash(git ls-remote *)",
      "Bash(git merge-base *)",
      "Bash(git reflog *)",
      "Bash(git remote -v)",
      "Bash(git remote get-url *)",
      "Bash(git remote show *)",
      "Bash(git rev-list *)",
      "Bash(git rev-parse *)",
      "Bash(git shortlog *)",
      "Bash(git show *)",
      "Bash(git stash list*)",
      "Bash(git stash show*)",
      "Bash(git status*)",
      "Bash(git submodule status*)",
      "Bash(git tag -l*)",
      "Bash(git worktree list*)",
      "Bash(gpg --show-keys *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(hostname)",
      "Bash(id *)",
      "Bash(id)",
      "Bash(jq *)",
      "Bash(kreadconfig6 *)",
      "Bash(launchctl list*)",
      "Bash(launchctl print *)",
      "Bash(ls *)",
      "Bash(lsb_release *)",
      "Bash(man *)",
      "Bash(md5sum *)",
      "Bash(nl *)",
      "Bash(npm ls*)",
      "Bash(npm outdated*)",
      "Bash(npm view *)",
      "Bash(nproc)",
      "Bash(od *)",
      "Bash(pgrep *)",
      "Bash(plutil -lint *)",
      "Bash(prettier --check *)",
      "Bash(printenv *)",
      "Bash(printf *)",
      "Bash(ps *)",
      "Bash(pwd)",
      "Bash(python3 -m py_compile *)",
      "Bash(readlink *)",
      "Bash(realpath *)",
      "Bash(rg *)",
      "Bash(sed -n *)",
      "Bash(seq *)",
      "Bash(sha256sum *)",
      "Bash(shasum *)",
      "Bash(sort *)",
      "Bash(stat *)",
      "Bash(strings *)",
      "Bash(sw_vers*)",
      "Bash(systemctl --user status *)",
      "Bash(systemctl status *)",
      "Bash(tail *)",
      "Bash(test *)",
      "Bash(tr *)",
      "Bash(true)",
      "Bash(tsc --noEmit*)",
      "Bash(uname *)",
      "Bash(uniq *)",
      "Bash(uptime)",
      "Bash(wc *)",
      "Bash(which *)",
      "Bash(xdg-mime query *)",
      "Bash(xxd *)",
      "Bash(zsh -n *)",
      "Read(//tmp/**)",
      "Read(~/**)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:github.com)",
      "WebSearch"
    ],
    "deny": [
      "Bash(fd *--exec*)",
      "Bash(fd *-X*)",
      "Bash(fd *-x*)",
      "Bash(git push*)",
      "Bash(rg *--pre*)",
      "Bash(sed *-i*)",
      "Bash(sort *-o*)",
      "Edit",
      "NotebookEdit",
      "Read(.env)",
      "Read(.env.*)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.netrc)",
      "Read(~/.ssh/**)",
      "Write"
    ],
    "defaultMode": "default",
    "additionalDirectories": [
      "/tmp"
    ]
  },
  "model": "fable[1m]",
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "caveman@caveman": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    }
  },
  "language": "English",
  "spinnerTipsEnabled": false,
  "effortLevel": "high",
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "tui": "default",
  "prefersReducedMotion": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "verbose": false,
  "preferredNotifChannel": "notifications_disabled",
  "autoCompactEnabled": false,
  "terminalProgressBarEnabled": false
}
